TOKEN_ENCRYPTION_KEY=
RATE_LIMIT_HASH_KEY=
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASS=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
