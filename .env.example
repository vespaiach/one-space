APP_IMAGE=your-dockerhub-username/one-space:0.1.0
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
DATABASE_URL_TEST=postgres://one_space_test:change-me@localhost:5432/one_space_feature_test
